# Copy to .env and fill in. Never commit .env.
# ---- LLM provider (plug and play) -------------------------------------------------------------
# nvidia | google | openai | openai_compatible | ollama
LLM_PROVIDER=nvidia
# Optional model override. Defaults: nvidia=nemotron-3-ultra-550b-a55b, google=gemini-3.5-flash,
# openai=gpt-4o-mini, ollama=qwen2.5-coder:7b
LLM_MODEL=
# Keys (only the one for your provider is needed). LLM_API_KEY overrides all of them.
NVIDIA_API_KEY=            # free: https://build.nvidia.com
GOOGLE_API_KEY=            # free tier: https://aistudio.google.com/apikey
OPENAI_API_KEY=
LLM_API_KEY=
# Local / self-hosted: openai_compatible (vLLM, LM Studio, llama.cpp, OpenRouter...) needs a URL;
# ollama defaults to http://localhost:11434/v1
LLM_BASE_URL=
# Free tiers rate-limit hard (Google free: roughly 10-15 requests/min). Lower this if you see 429s.
EXTRACTION_CONCURRENCY=4

# Neo4j (defaults match: docker run -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:5)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Browser origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:7860"]

# Safety / limits
MAX_UPLOAD_MB=50
CONTAINER_TIMEOUT_SECONDS=300
CONTAINER_MEMORY_LIMIT_MB=4096
TRANSLATION_TIMEOUT_SECONDS=1800
