# SoulGraph Ephemeral Sandbox Image
# Why: AI-generated code is untrusted. This image is the ONLY thing it runs inside.
# Deps are baked in at build time because the container runs with network_mode="none".
#
# Build:  docker build -f sandbox/Dockerfile.sandbox -t soulgraph-runtime:latest .
# (tag must match settings.DOCKER_SANDBOX_IMAGE)

# Pinned base: reproducible. `:latest` would silently change torch under us.
FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Whitelist from CriticAgent.run_static_analysis: torch, jax, equinox, einops, numpy.
# The harness does `import jax` unconditionally, so it must exist (CPU build is enough:
# JAX code only needs to trace/run a dummy forward pass).
RUN pip install \
        "jax==0.4.30" "jaxlib==0.4.30" \
        "equinox==0.11.4" \
        "einops==0.8.0" \
        "numpy<2"

# Non-root user matching `user="1000:1000"` in docker_controller.
RUN groupadd -g 1000 soulgraph_group && \
    useradd -u 1000 -g soulgraph_group -m -s /bin/bash soulgraph_user

WORKDIR /workspace
USER soulgraph_user

# The controller supplies the command; this is only a safe default.
CMD ["python", "/workspace/main_run.py"]
